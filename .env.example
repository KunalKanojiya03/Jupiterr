# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required when deployed: passcode that unlocks the dashboard
APP_PASSCODE=

# Optional: HMAC secret for the run ledger (defaults to a hash of passcode + key)
LEDGER_SECRET=

# Optional: budget and loop limits
RUN_BUDGET_USD=0.50
MAX_QA_ROUNDS=2
STEP_DEADLINE_S=270

# Optional: estimated USD per 1M tokens, used for the spend meter and budget cap
PRICE_PER_MTOK_IN=0.50
PRICE_PER_MTOK_OUT=3.00

# Optional: model failover chains (first = primary). Global, or per role.
# MODEL_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# QA_MODELS=gemini-3.8-flash,openai_compat:llama-3.3-70b-versatile

# Optional: any OpenAI-compatible provider (Groq, OpenRouter, ...) as extra failover
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
